# Drizzle / SQLite (libSQL). En local, un archivo real; en producción, la URL de Turso.
DATABASE_URL=file:local.db
# Solo necesario en producción (Turso). Vacío en local.
DATABASE_AUTH_TOKEN=

# TMDb API v3 (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Trakt OAuth (https://trakt.tv/oauth/applications), para importar visto/watchlist de cada usuario.
# Redirect uri a registrar en la app de Trakt: <origen>/api/trakt/callback
# (en dev: http://localhost:5173/api/trakt/callback)
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
